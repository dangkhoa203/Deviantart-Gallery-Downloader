<mah:MetroWindow x:Class="DeviantartDownloader.Views.MoreSelectView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:DeviantartDownloader.Views"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:viewmodels="clr-namespace:DeviantartDownloader.ViewModels"
                 xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                 Dialog:DialogParticipation.Register="{Binding}"
                 d:DataContext="{d:DesignInstance Type=viewmodels:MoreSelectViewModel}"
                 mc:Ignorable="d"
                 Height="450" Width="800"
                 ResizeMode="NoResize" ShowIconOnTitleBar="False"
                 WindowStartupLocation="CenterScreen" WindowTitleBrush="#06070d"
                 Background="#d4dfd0" BorderBrush="Black"
                 Title="Selection">
    <Grid RowDefinitions="*,100">
        <StackPanel Grid.Row="0">
            <Label Content="Username"
                   FontSize="17" Margin="20,0,20,0"/>
            <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                     mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                     mah:ControlsHelper.CornerRadius="4"
                     Background="#e9f0e6"
                     Foreground="#337287" FontWeight="SemiBold"
                     BorderBrush="#93a98f"
                     Height="35" FontSize="18"
                     Text="{Binding AuthorName ,UpdateSourceTrigger=PropertyChanged}"
                     Margin="20,0,20,0">
            </TextBox>
            <Label Content="Title"
                   FontSize="17" Margin="20,0,20,0"/>
            <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                     mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                     mah:ControlsHelper.CornerRadius="4"
                     Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"
                     Background="#e9f0e6"
                     Foreground="#337287" FontWeight="SemiBold"
                     BorderBrush="#93a98f"
                     Height="35" FontSize="18"
                     Margin="20,0,20,0">
            </TextBox>
            <Label Content="Time frame" 
                   FontSize="17" Margin="20,10,20,0"/>
            <StackPanel Margin="20,0,20,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Year"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding BeforeYear,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f"  Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Year_PreviewTextInput" MaxLength="4"/>
                <Label Content="Month"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding BeforeMonth,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f"  Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Month_PreviewTextInput" MaxLength="2"/>
                <Label Content="Day"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding BeforeDay,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f"  Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Day_PreviewTextInput" MaxLength="2"/>
            </StackPanel>
            <Label Content="To" 
                   FontSize="20" Margin="0,10,0,10" 
                   HorizontalAlignment="Center"/>
            <StackPanel Margin="20,0,20,0" 
                        Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Year"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding AfterYear,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f"  Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Year_PreviewTextInput" MaxLength="4"/>
                <Label Content="Month"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding AfterMonth,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f"  Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Month_PreviewTextInput" MaxLength="2"/>
                <Label Content="Day"/>
                <TextBox mah:ControlsHelper.FocusBorderBrush="#93a98f"
                         mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                         mah:ControlsHelper.CornerRadius="4"
                         Text="{Binding AfterDay,UpdateSourceTrigger=PropertyChanged}"
                         Background="#e9f0e6"
                         Foreground="#337287" FontWeight="SemiBold"
                         BorderBrush="#93a98f" Width="60" Margin="0,0,40,0" FontSize="14" 
                         PreviewTextInput="Day_PreviewTextInput" MaxLength="2"/>
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="1"
                mah:ControlsHelper.CornerRadius="2"
                mah:ControlsHelper.ContentCharacterCasing="Upper"
                mah:ControlsHelper.FocusBorderBrush="#93a98f"
                mah:ControlsHelper.MouseOverBorderBrush="#93a98f"
                Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                Command="{Binding SelectCommand}"
                BorderBrush="#93a98f" BorderThickness="2"
                FontSize="20" Cursor="Hand"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="700"
                Height="60"
                Margin="0,0,0,0"
                Content="Select"/>
    </Grid>
</mah:MetroWindow>
